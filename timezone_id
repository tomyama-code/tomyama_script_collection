use strict;                         # first released with perl 5
use warnings;                       # first released with perl v5.6.0
use File::Basename qw();            # first released with perl 5
use Getopt::Long qw();              # first released with perl 5


##########
## スクリプトのエントリポイント
sub pl_main( @ )
{
    ## 初期化処理
    init_script();

    ## 引数解析
    my $reaction = parse_arg( @_ );

    param_print();

    if( $main::banner ){
        $main::banner = 0;
        my $banner_msg = '' .
            qq{--------------------------------------------------\n} .
            uc( $main::appname ) . qq{ -- List IANA timezone IDs\n} .
            qq{- This uses bundled IANA data instead of the host system's timezone data.\n} .
            qq{- Version: } . GetVersion() . "\n" .
            qq{- Document: https://github.com/tomyama-code/tomyama_script_collection/blob/main/docs/$main::appname.md\n} .
            qq{--------------------------------------------------\n};
        print( $banner_msg );
    }

    if( $main::help || $main::version ){
        if( $main::help ){
            $main::help = 0;
            usage( 0 );
        }
        if( $main::version ){
            $main::version = 0;
            PrintVersion();
        }
        return 0;
    }

    open( DATFILE, '<', $main::datafile ) ||
        die( qq{$main::datafile: could not open file: $!} );
    my $line_row = 0;
    my @matched = ();
    my $tz_id_len_max = 0;
    my $re_flag = '';
    $re_flag .= 'i' if( $main::ignorecase );
    while( <DATFILE> ){
        $line_row++;
        my $line = $_;
        $line =~ s/\r?\n$//o;
        #print( qq{$line\n} );

        my $b_disp = 1;
        if( $line_row > 1 && $main::use_filter ){
            for my $filter( @main::filters ){
                # インライン修飾子 (?imsx) を埋め込んだ正規表現
                if( !( $line =~ m/(?$re_flag)$filter/ ) ){
                    $b_disp = 0;
                    last;
                }
            }
        }

        if( $b_disp ){
            # SDT: Standard Time, 標準時（冬時間、平時）
            # DST: Daylight Saving Time, 夏時間（日光節約時間）
            my( $sdt, $dst, $sdt2, $dst2, $tz_id, $cmt, $note, $lat, $lon, $cc, $cname ) =
                split( /\t/, $line );
            my $tz_id_len = length( $tz_id );
            $tz_id_len_max = $tz_id_len if( $tz_id_len > $tz_id_len_max );
            push( @matched, $line );
        }
    }
    close( DATFILE );

    for my $line( @matched ){
        my( $sdt, $dst, $sdt2, $dst2, $tz_id, $cmt, $note, $lat, $lon, $cc, $cname ) =
            split( /\t/, $line );

        if( $main::verbose ){
            printf( qq{%-6s %-5s  %-6s %-5s  %-22s %-*s  "%s"  "%s"  %s  %s\n},
                $sdt, $sdt2, $dst, $dst2, "$lat, $lon", $tz_id_len_max, $tz_id, $cmt, $note, $cc, $cname );
        }else{
            printf( qq{%-6s %-5s  %-22s %-*s  %s\n},
                $sdt, $sdt2, "$lat, $lon", $tz_id_len_max, $tz_id, $cc );
        }
    }

    return 0;
}

##########
## 初期化処理
## Revision: 1.3
sub init_script()
{
    my $exec_file = $0;
    $exec_file =~ s!^.*tests/(.*)\.t$!$1!;

    ### GLOBAL ###
    $main::apppath = File::Basename::dirname( $exec_file );
    $main::appname = File::Basename::basename( $exec_file );
    @main::argv = ();
    $main::argc = 0;
    $main::datafile = "$main::apppath/$main::appname.tab";
    $main::banner = 0;
    $main::debug = 0;
    $main::ignorecase = 0;
    $main::verbose = 0;
    $main::version = 0;
    $main::help = 0;
    @main::filters = ();
    $main::use_filter = 0;
    ## ［ANSIエスケープシーケンス］を使うか否かの判定で使う
#    $main::bUseAnsiEscSeqColor = -t STDOUT;
#    $main::bIsStdinATty = -t STDIN;
    ##############
}

sub param_print()
{
    dPrintf( qq{Parameter Print\n} .
             qq{     \$main::apppath = "%s"\n} .
             qq{     \$main::appname = "%s"\n} .
             qq{     \@main::argv = (%s)\n} .
             qq{     \$main::argc = %d\n} .
             qq{     \$main::banner = %d\n} .
             qq{     \$main::debug = %d\n} .
             qq{     \$main::ignorecase = %d\n} .
             qq{     \$main::verbose = %d\n} .
             qq{     \$main::version = %d\n} .
             qq{     \$main::help = %d\n} .
             qq{     \@main::filters = (%s)\n} .
             qq{     \$main::use_filter = %d\n},
        $main::apppath,
        $main::appname,
        array_to_str( @main::argv ),
        $main::argc,
        $main::banner,
        $main::debug,
        $main::ignorecase,
        $main::verbose,
        $main::version,
        $main::help,
        array_to_str( @main::filters ),
        $main::use_filter );
}

sub array_to_str( @ )
{
    return q{ '} . join( q{', '}, @_ ) . q{' } if( scalar( @_ ) > 0 );
    return '';
}

##########
## 引数解析
sub parse_arg()
{
    @main::argv = @_;
    $main::argc = scalar( @main::argv );

    # Getopt::Long が動くように局所的に変更して騙す
    local @ARGV = @main::argv;

    # 設定: ショートオプションのまとめ指定（バンドリング）を有効化
    Getopt::Long::Configure("bundling");

    Getopt::Long::GetOptions(
        'banner|b'     => \$main::banner,
        'debug|d'      => \$main::debug,
        'ignorecase|i' => \$main::ignorecase,
        'verbose|v'    => \$main::verbose,
        'version'      => \$main::version,
        'help|h'       => \$main::help,
        'datafile=s'   => \$main::datafile,
    ) || die( qq{parse_arg(): error: Failed to parse option switches.\n} );

    while( my $myparam = shift( @ARGV ) ){
        push( @main::filters, $myparam );
        #dPrint( qq{filters += "$myparam"\n} );
    }

    $main::use_filter = 1 if( scalar( @main::filters ) > 0 );
}

##########
