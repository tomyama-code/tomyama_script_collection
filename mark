## 初期化処理
## Revision: 1.3
sub init_script()
{
    my $exec_file = $0;
    $exec_file =~ s!^.*tests/(.*)\.t$!$1!;

    ### GLOBAL ###
    $main::apppath = File::Basename::dirname( $exec_file );
    $main::appname = File::Basename::basename( $exec_file );
    $main::argc = 0;
    $main::debug = 0;
    $main::numbering = 0;
    $main::prt_fname = undef;
    $main::help = 0;
    $main::version = 0;
    $main::flag_head_tail = 0;
    $main::flag_filter = 0;
    $main::buffer_pre  = 5;
    $main::buffer_post = 5;
    @main::pre_buffer = ();
    $main::post_buffer_counter = 0;
    $main::ignorecase = 0;
    $main::re = undef;
    @main::fi_in = ();
    $main::syscall_act = 0;
    ## ［ANSIエスケープシーケンス］を使うか否かの判定で使う
    $main::bUseAnsiEscSeqColor = -t STDOUT;
    ##############
}

